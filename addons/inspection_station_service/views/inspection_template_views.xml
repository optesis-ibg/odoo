<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Question option inline list ───────────────────────────────────── -->
    <record id="view_inspection_question_option_list_inline" model="ir.ui.view">
        <field name="name">inspection.question.option.list.inline</field>
        <field name="model">inspection.question.option</field>
        <field name="arch" type="xml">
            <tree editable="bottom" string="Options">
                <field name="sequence" widget="handle"/>
                <field name="name" placeholder="Libellé de l'option..."/>
                <field name="score"/>
                <field name="color" widget="color"/>
            </tree>
        </field>
    </record>

    <!-- ── Template list view ─────────────────────────────────────────────── -->
    <record id="view_inspection_template_list" model="ir.ui.view">
        <field name="name">inspection.template.list</field>
        <field name="model">inspection.template</field>
        <field name="arch" type="xml">
            <tree string="Modèles d'inspection" decoration-muted="active == False">
                <field name="name"/>
                <field name="code"/>
                <field name="question_count" string="Questions"/>
                <field name="total_max_score" string="Score max"/>
                <field name="report_count" string="Rapports"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- ── Template form view ─────────────────────────────────────────────── -->
    <record id="view_inspection_template_form" model="ir.ui.view">
        <field name="name">inspection.template.form</field>
        <field name="model">inspection.template</field>
        <field name="arch" type="xml">
            <form string="Modèle d'inspection">
                <header>
                    <button name="action_view_reports"
                            string="Voir les rapports"
                            type="object"
                            class="btn-secondary"
                            attrs="{'invisible': [('report_count', '=', 0)]}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_reports"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-clipboard-list">
                            <field name="report_count" widget="statinfo" string="Rapports"/>
                        </button>
                        <button type="object" name="action_view_reports"
                                class="oe_stat_button" icon="fa-question-circle">
                            <field name="question_count" widget="statinfo" string="Questions"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Modèle d'inspection"/>
                        <h1>
                            <field name="name" placeholder="Nom du modèle..."/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="code" placeholder="MOD-001"/>
                            <field name="active"/>
                            <field name="total_max_score" readonly="1"/>
                        </group>
                        <group>
                            <field name="site_ids" widget="many2many_tags"
                                   placeholder="Sélectionner les sites applicables..."/>
                        </group>
                    </group>

                    <field name="description" placeholder="Description du modèle d'inspection..."/>

                    <notebook>
                        <page string="Questions" name="questions">
                            <field name="question_ids">
                                <tree editable="bottom" string="Questions">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" placeholder="Intitulé de la question..." required="1"/>
                                    <field name="category" placeholder="Catégorie..."/>
                                    <field name="question_type"/>
                                    <field name="max_score"/>
                                    <field name="required"/>
                                    <field name="option_ids" widget="many2many_tags"
                                           attrs="{'invisible': [('question_type', '!=', 'selection')]}"
                                           string="Options"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Détail des questions" name="questions_detail">
                            <field name="question_ids">
                                <form string="Question">
                                    <group>
                                        <group string="Question">
                                            <field name="name" string="Intitulé"/>
                                            <field name="question_type"/>
                                            <field name="category"/>
                                            <field name="sequence"/>
                                            <field name="required"/>
                                            <field name="max_score"
                                                   attrs="{'invisible': [('question_type', '=', 'formula')]}"/>
                                        </group>
                                        <group string="Aide">
                                            <field name="description" nolabel="1"
                                                   placeholder="Instructions pour l'inspecteur..."/>
                                        </group>
                                    </group>

                                    <!-- Options (selection type) -->
                                    <group string="Options de réponse"
                                           attrs="{'invisible': [('question_type', '!=', 'selection')]}">
                                        <field name="option_ids" nolabel="1">
                                            <tree editable="bottom">
                                                <field name="sequence" widget="handle"/>
                                                <field name="name" placeholder="Option..."/>
                                                <field name="score"/>
                                                <field name="color"/>
                                            </tree>
                                        </field>
                                    </group>

                                    <!-- Formula -->
                                    <group string="Formule de calcul"
                                           attrs="{'invisible': [('question_type', '!=', 'formula')]}">
                                        <field name="formula" nolabel="1"
                                               placeholder="Ex : Q1 + Q2 * 0.5 — utilisez Q&lt;séquence&gt; pour référencer d'autres questions"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── Template search view ───────────────────────────────────────────── -->
    <record id="view_inspection_template_search" model="ir.ui.view">
        <field name="name">inspection.template.search</field>
        <field name="model">inspection.template</field>
        <field name="arch" type="xml">
            <search string="Rechercher un modèle">
                <field name="name"/>
                <field name="code"/>
                <field name="site_ids"/>
                <separator/>
                <filter string="Actifs" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archivés" name="archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- ── Template action ────────────────────────────────────────────────── -->
    <record id="action_inspection_template" model="ir.actions.act_window">
        <field name="name">Modèles d'inspection</field>
        <field name="res_model">inspection.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_inspection_template_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier modèle d'inspection
            </p>
            <p>
                Définissez les questions, types de réponse et scores pour chaque critère.
            </p>
        </field>
    </record>

</odoo>
