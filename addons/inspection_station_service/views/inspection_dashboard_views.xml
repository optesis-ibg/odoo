<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Assets: inject JS, CSS into the backend bundle -->
    <template id="assets_backend" inherit_id="web.assets_backend">
        <xpath expr="." position="inside">
            <link rel="stylesheet" type="text/css"
                  href="/inspection_station_service/static/src/css/inspection.css"/>
            <script type="text/javascript"
                    src="/web/static/lib/Chart/Chart.js"/>
            <script type="text/javascript"
                    src="/inspection_station_service/static/src/js/inspection_dashboard.js"/>
        </xpath>
    </template>

    <!-- Dashboard client action -->
    <record id="action_inspection_dashboard" model="ir.actions.client">
        <field name="name">Tableau de bord Inspection</field>
        <field name="tag">inspection_station_service.dashboard</field>
        <field name="params">{}</field>
    </record>

</odoo>
