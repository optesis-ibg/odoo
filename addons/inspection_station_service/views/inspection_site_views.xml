<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List view ──────────────────────────────────────────────────────── -->
    <record id="view_inspection_site_list" model="ir.ui.view">
        <field name="name">inspection.site.list</field>
        <field name="model">inspection.site</field>
        <field name="arch" type="xml">
            <tree string="Sites d'inspection" decoration-muted="active == False">
                <field name="code"/>
                <field name="name"/>
                <field name="site_type"/>
                <field name="city"/>
                <field name="manager_id"/>
                <field name="phone"/>
                <field name="inspection_count" string="Inspections"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- ── Form view ──────────────────────────────────────────────────────── -->
    <record id="view_inspection_site_form" model="ir.ui.view">
        <field name="name">inspection.site.form</field>
        <field name="model">inspection.site</field>
        <field name="arch" type="xml">
            <form string="Site d'inspection">
                <header>
                    <button name="action_view_inspections"
                            string="Voir les inspections"
                            type="object"
                            class="btn-primary"
                            attrs="{'invisible': [('inspection_count', '=', 0)]}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_inspections"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-clipboard">
                            <field name="inspection_count" widget="statinfo" string="Inspections"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Nom du site"/>
                        <h1>
                            <field name="name" placeholder="Nom du site..."/>
                        </h1>
                        <label for="code" string="Code"/>
                        <h2>
                            <field name="code" placeholder="EX-001"/>
                        </h2>
                    </div>

                    <group>
                        <group string="Informations générales">
                            <field name="site_type"/>
                            <field name="manager_id"/>
                            <field name="phone"/>
                            <field name="email" widget="email"/>
                            <field name="active"/>
                        </group>
                        <group string="Localisation">
                            <field name="address"/>
                            <field name="city"/>
                            <field name="zip_code"/>
                            <field name="country_id"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Observations, informations complémentaires..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── Search view ────────────────────────────────────────────────────── -->
    <record id="view_inspection_site_search" model="ir.ui.view">
        <field name="name">inspection.site.search</field>
        <field name="model">inspection.site</field>
        <field name="arch" type="xml">
            <search string="Rechercher un site">
                <field name="name" string="Nom / Code" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="city"/>
                <field name="manager_id"/>
                <separator/>
                <filter string="Actifs" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archivés" name="archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Station Service" name="station" domain="[('site_type', '=', 'station')]"/>
                <filter string="Dépôt" name="depot" domain="[('site_type', '=', 'depot')]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Type" name="grp_type" context="{'group_by': 'site_type'}"/>
                    <filter string="Ville" name="grp_city" context="{'group_by': 'city'}"/>
                    <filter string="Responsable" name="grp_manager" context="{'group_by': 'manager_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Kanban view ────────────────────────────────────────────────────── -->
    <record id="view_inspection_site_kanban" model="ir.ui.view">
        <field name="name">inspection.site.kanban</field>
        <field name="model">inspection.site</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" default_group_by="site_type">
                <field name="name"/>
                <field name="code"/>
                <field name="city"/>
                <field name="manager_id"/>
                <field name="inspection_count"/>
                <field name="site_type"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_tags_section">
                                    <span class="badge badge-pill badge-info">
                                        <field name="code"/>
                                    </span>
                                </div>
                                <ul>
                                    <li t-if="record.city.value">
                                        <i class="fa fa-map-marker mr-1"/>
                                        <field name="city"/>
                                    </li>
                                    <li t-if="record.manager_id.value">
                                        <i class="fa fa-user mr-1"/>
                                        <field name="manager_id"/>
                                    </li>
                                    <li>
                                        <i class="fa fa-clipboard mr-1"/>
                                        <t t-esc="record.inspection_count.value"/> inspections
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── Action ─────────────────────────────────────────────────────────── -->
    <record id="action_inspection_site" model="ir.actions.act_window">
        <field name="name">Sites d'inspection</field>
        <field name="res_model">inspection.site</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_inspection_site_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier site d'inspection
            </p>
            <p>
                Configurez les stations service et sites à inspecter.
            </p>
        </field>
    </record>

</odoo>
